# ============================================================
# catalog-service — Environment Variables Template
# Sao chép file này thành .env và điền giá trị thực vào
# KHÔNG commit file .env lên git
# ============================================================

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/mc_music_db?currentSchema=mc_music_catalog_schema
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- JWT Secrets (Multi-issuer — phải khớp với từng service phát hành) ---
# Lấy từ jwt.secret của users-service
JWT_SECRET_USER=your_users_service_jwt_secret
# Lấy từ jwt.secret của artists-service
JWT_SECRET_ARTIST=your_artists_service_jwt_secret
# Lấy từ jwt.secret của admin-service
JWT_SECRET_ADMIN=your_admin_service_jwt_secret

# --- Cloudinary (đăng ký tại https://cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Internal Service URLs ---
ARTISTS_SERVICE_URL=http://localhost:8083

# --- Internal API Secret ---
# Phải khớp với giá trị INTERNAL_API_SECRET trong tất cả các service khác
INTERNAL_API_SECRET=your_shared_internal_api_secret
