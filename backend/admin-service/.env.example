# ============================================================
# admin-service — Environment Variables Template
# Sao chép file này thành .env và điền giá trị thực vào
# KHÔNG commit file .env lên git
# ============================================================

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/mc_music_db?currentSchema=mc_music_admin_schema
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- JWT (Admin domain) ---
# Phải là chuỗi ngẫu nhiên, tối thiểu 32 ký tự
# KHÔNG được dùng chung secret với users-service hay artists-service
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
