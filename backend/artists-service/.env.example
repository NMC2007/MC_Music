# ============================================================
# artists-service — Environment Variables Template
# Sao chép file này thành .env và điền giá trị thực vào
# KHÔNG commit file .env lên git
# ============================================================

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/mc_music_db?currentSchema=mc_music_artists_schema
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- JWT (Artists domain) ---
# Phải là chuỗi ngẫu nhiên, tối thiểu 32 ký tự
# KHÔNG được dùng chung secret với users-service hay admin-service
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# --- Internal API Secret ---
# Phải khớp với giá trị INTERNAL_API_SECRET trong tất cả các service khác
INTERNAL_API_SECRET=your_shared_internal_api_secret
