# ==============================================================================
# MC MUSIC — ROOT ENVIRONMENT VARIABLES TEMPLATE (DOCKER COMPOSE & CD)
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép tệp này thành .env: cp .env.example .env (hoặc copy .env.example .env)
# 2. Điền các giá trị thực tế của môi trường (staging/production).
# 3. KHÔNG commit tệp .env lên hệ thống quản lý mã nguồn (Git).
# ==============================================================================

# ─── 1. POSTGRESQL DATABASE ───────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=Manhcuong281207@
DB_NAME=mc_music_db
DB_PORT=5432

# ─── 2. APACHE KAFKA ──────────────────────────────────────────────────────────
KAFKA_PORT=9092

# ─── 3. JWT SECRET KEYS (Tối thiểu 32 ký tự để đảm bảo chuẩn HMAC-SHA256) ────
JWT_SECRET_USER=superSecretKeyForMcMusicAppThatIsAtLeast32CharactersLong2026!
JWT_SECRET_ARTIST=superSecretKeyForArtistsServiceThatIsAtLeast32CharsLong2026!
JWT_SECRET_ADMIN=superSecretKeyForAdminServiceThatIsAtLeast32CharsLong2026!
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ─── 4. GIAO TIẾP NỘI BỘ GIỮA CÁC MICROSERVICES (INTERNAL API SECRET) ──────────
INTERNAL_API_SECRET=SuperSecretKeyForInternalMicroserviceCommunication_McMusic2026

# ─── 5. CLOUDINARY CDN (LƯU TRỮ BẢN THU ÂM THANH & ẢNH BÌA) ───────────────────
